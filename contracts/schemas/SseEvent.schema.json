{
  "$defs": {
    "ActionRun": {
      "additionalProperties": false,
      "description": "One execution of a runbook step's action for an alert (table action_runs).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "runbook_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Runbook Id",
          "type": "string"
        },
        "step_index": {
          "title": "Step Index",
          "type": "integer"
        },
        "action_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/ActionRunStatus"
        },
        "attempt": {
          "default": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "requested_by": {
          "$ref": "#/$defs/Actor"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "alert_id",
        "runbook_id",
        "step_index",
        "action_id",
        "params",
        "status",
        "requested_by",
        "created_at",
        "updated_at"
      ],
      "title": "ActionRun",
      "type": "object"
    },
    "ActionRunStatus": {
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "running",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "ActionRunStatus",
      "type": "string"
    },
    "ActionRunUpdatedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "action_run.updated",
          "default": "action_run.updated",
          "title": "Type",
          "type": "string"
        },
        "action_run": {
          "$ref": "#/$defs/ActionRun"
        }
      },
      "required": [
        "at",
        "action_run"
      ],
      "title": "ActionRunUpdatedEvent",
      "type": "object"
    },
    "Actor": {
      "additionalProperties": false,
      "description": "Who performed something: a recipient id, 'system:<service>' or 'llm'.",
      "properties": {
        "id": {
          "examples": [
            "anna",
            "system:processor",
            "llm"
          ],
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Alert": {
      "additionalProperties": false,
      "description": "Table alerts. One alert per (rule_id, fingerprint) per dedup window, or per group window.",
      "properties": {
        "id": {
          "description": "UUID v7.",
          "title": "Id",
          "type": "string"
        },
        "rule_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "team": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Team",
          "type": "string"
        },
        "schema_profile_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Schema Profile Id",
          "type": "string"
        },
        "source_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "group_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Key"
        },
        "is_group_summary": {
          "default": false,
          "title": "Is Group Summary",
          "type": "boolean"
        },
        "group_members": {
          "items": {
            "$ref": "#/$defs/GroupMember"
          },
          "title": "Group Members",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "default": "",
          "title": "Body",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/AlertField"
          },
          "title": "Fields",
          "type": "array"
        },
        "color": {
          "default": "orange",
          "title": "Color",
          "type": "string"
        },
        "count": {
          "default": 1,
          "description": "Events folded in by dedup.",
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus",
          "default": "open"
        },
        "runbook_id": {
          "anyOf": [
            {
              "examples": [
                "rates-large-rejections"
              ],
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runbook Id"
        },
        "last_event": {
          "additionalProperties": true,
          "description": "Raw payload of the most recent event.",
          "title": "Last Event",
          "type": "object"
        },
        "acknowledged_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "acknowledged_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acknowledged At"
        },
        "resolved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At"
        },
        "resolution_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "rule_id",
        "team",
        "schema_profile_id",
        "source_id",
        "fingerprint",
        "severity",
        "title",
        "first_seen",
        "last_seen",
        "last_event"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertCreatedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "alert.created",
          "default": "alert.created",
          "title": "Type",
          "type": "string"
        },
        "alert": {
          "$ref": "#/$defs/Alert"
        }
      },
      "required": [
        "at",
        "alert"
      ],
      "title": "AlertCreatedEvent",
      "type": "object"
    },
    "AlertField": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "path"
      ],
      "title": "AlertField",
      "type": "object"
    },
    "AlertStatus": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "AlertUpdatedEvent": {
      "additionalProperties": false,
      "description": "Count, status or group membership changed. Dedup increments are coalesced to <= 1/s per alert.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "alert.updated",
          "default": "alert.updated",
          "title": "Type",
          "type": "string"
        },
        "alert": {
          "$ref": "#/$defs/Alert"
        }
      },
      "required": [
        "at",
        "alert"
      ],
      "title": "AlertUpdatedEvent",
      "type": "object"
    },
    "ApprovalDecidedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "approval.decided",
          "default": "approval.decided",
          "title": "Type",
          "type": "string"
        },
        "approval_request": {
          "$ref": "#/$defs/ApprovalRequest"
        }
      },
      "required": [
        "at",
        "approval_request"
      ],
      "title": "ApprovalDecidedEvent",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalPolicy": {
      "enum": [
        "none",
        "required"
      ],
      "title": "ApprovalPolicy",
      "type": "string"
    },
    "ApprovalRequest": {
      "additionalProperties": false,
      "description": "A human decision gating an action run (table approval_requests).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action_run_id": {
          "title": "Action Run Id",
          "type": "string"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "team": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Team",
          "type": "string"
        },
        "summary": {
          "description": "Rendered step text shown to the approver.",
          "title": "Summary",
          "type": "string"
        },
        "approval_code": {
          "description": "Reply 'APPROVE <code>' or 'REJECT <code>'.",
          "pattern": "^[0-9]{4}$",
          "title": "Approval Code",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decided_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decided_via": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalVia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "required": [
        "id",
        "action_run_id",
        "alert_id",
        "team",
        "summary",
        "approval_code",
        "requested_at"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "ApprovalRequestedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "approval.requested",
          "default": "approval.requested",
          "title": "Type",
          "type": "string"
        },
        "approval_request": {
          "$ref": "#/$defs/ApprovalRequest"
        }
      },
      "required": [
        "at",
        "approval_request"
      ],
      "title": "ApprovalRequestedEvent",
      "type": "object"
    },
    "ApprovalVia": {
      "enum": [
        "ui",
        "sms",
        "phone"
      ],
      "title": "ApprovalVia",
      "type": "string"
    },
    "AutoResolvePolicy": {
      "additionalProperties": false,
      "properties": {
        "on_resolution_event": {
          "default": true,
          "title": "On Resolution Event",
          "type": "boolean"
        },
        "after_silence": {
          "anyOf": [
            {
              "examples": [
                "60s",
                "5m",
                "1h"
              ],
              "pattern": "^[0-9]+(ms|s|m|h|d)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Silence"
        }
      },
      "title": "AutoResolvePolicy",
      "type": "object"
    },
    "ChannelType": {
      "enum": [
        "ui",
        "email",
        "sms",
        "phone",
        "webhook"
      ],
      "title": "ChannelType",
      "type": "string"
    },
    "ConditionAll": {
      "additionalProperties": false,
      "properties": {
        "all": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConditionAll"
              },
              {
                "$ref": "#/$defs/ConditionAny"
              },
              {
                "$ref": "#/$defs/ConditionNot"
              },
              {
                "$ref": "#/$defs/ConditionLeaf"
              }
            ]
          },
          "minItems": 1,
          "title": "All",
          "type": "array"
        }
      },
      "required": [
        "all"
      ],
      "title": "ConditionAll",
      "type": "object"
    },
    "ConditionAny": {
      "additionalProperties": false,
      "properties": {
        "any": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConditionAll"
              },
              {
                "$ref": "#/$defs/ConditionAny"
              },
              {
                "$ref": "#/$defs/ConditionNot"
              },
              {
                "$ref": "#/$defs/ConditionLeaf"
              }
            ]
          },
          "minItems": 1,
          "title": "Any",
          "type": "array"
        }
      },
      "required": [
        "any"
      ],
      "title": "ConditionAny",
      "type": "object"
    },
    "ConditionLeaf": {
      "additionalProperties": false,
      "description": "Compare one field. A missing field never matches, except `exists` with value false.",
      "properties": {
        "field": {
          "examples": [
            "payload.notional",
            "normalized.severity"
          ],
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/ConditionOperator"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "ConditionLeaf",
      "type": "object"
    },
    "ConditionNot": {
      "additionalProperties": false,
      "properties": {
        "not": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionAll"
            },
            {
              "$ref": "#/$defs/ConditionAny"
            },
            {
              "$ref": "#/$defs/ConditionNot"
            },
            {
              "$ref": "#/$defs/ConditionLeaf"
            }
          ],
          "title": "Not"
        }
      },
      "required": [
        "not"
      ],
      "title": "ConditionNot",
      "type": "object"
    },
    "ConditionOperator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "in",
        "glob",
        "regex",
        "exists"
      ],
      "title": "ConditionOperator",
      "type": "string"
    },
    "ConfigChangedEvent": {
      "additionalProperties": false,
      "description": "Also the payload of pub/sub channel `config.changed` that makes workers reload.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "config.changed",
          "default": "config.changed",
          "title": "Type",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "at",
        "kind",
        "id",
        "version"
      ],
      "title": "ConfigChangedEvent",
      "type": "object"
    },
    "DedupPolicy": {
      "additionalProperties": false,
      "properties": {
        "window": {
          "default": "60s",
          "examples": [
            "60s",
            "5m",
            "1h"
          ],
          "pattern": "^[0-9]+(ms|s|m|h|d)$",
          "title": "Window",
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "items": {
                "examples": [
                  "payload.notional",
                  "normalized.severity"
                ],
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the schema profile fingerprint for this rule.",
          "title": "Fingerprint"
        }
      },
      "title": "DedupPolicy",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "description": "Table deliveries; one row per outbox delivery entry, updated by delivery workers.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "team": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Team",
          "type": "string"
        },
        "recipient_id": {
          "anyOf": [
            {
              "examples": [
                "rates-large-rejections"
              ],
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recipient Id"
        },
        "channel_id": {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "title": "Channel Id",
          "type": "string"
        },
        "channel_type": {
          "$ref": "#/$defs/ChannelType"
        },
        "purpose": {
          "$ref": "#/$defs/DeliveryPurpose"
        },
        "status": {
          "$ref": "#/$defs/DeliveryStatus"
        },
        "attempt": {
          "default": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "is_fallback": {
          "default": false,
          "title": "Is Fallback",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "delivered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At"
        }
      },
      "required": [
        "id",
        "alert_id",
        "team",
        "channel_id",
        "channel_type",
        "purpose",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "Delivery",
      "type": "object"
    },
    "DeliveryPurpose": {
      "enum": [
        "alert",
        "approval_request",
        "group_summary"
      ],
      "title": "DeliveryPurpose",
      "type": "string"
    },
    "DeliveryStatus": {
      "enum": [
        "pending",
        "sent",
        "failed",
        "delivered",
        "dead_lettered",
        "suppressed"
      ],
      "title": "DeliveryStatus",
      "type": "string"
    },
    "DeliveryUpdatedEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "type": {
          "const": "delivery.updated",
          "default": "delivery.updated",
