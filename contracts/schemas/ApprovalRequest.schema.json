{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Who performed something: a recipient id, 'system:<service>' or 'llm'.",
      "properties": {
        "id": {
          "examples": [
            "anna",
            "system:processor",
            "llm"
          ],
          "title": "Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        }
      },
      "required": [
        "id"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ApprovalVia": {
      "enum": [
        "ui",
        "sms",
        "phone"
      ],
      "title": "ApprovalVia",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A human decision gating an action run (table approval_requests).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "action_run_id": {
      "title": "Action Run Id",
      "type": "string"
    },
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "team": {
      "examples": [
        "rates-large-rejections"
      ],
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
      "title": "Team",
      "type": "string"
    },
    "summary": {
      "description": "Rendered step text shown to the approver.",
      "title": "Summary",
      "type": "string"
    },
    "approval_code": {
      "description": "Reply 'APPROVE <code>' or 'REJECT <code>'.",
      "pattern": "^[0-9]{4}$",
      "title": "Approval Code",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Actor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decided_via": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalVia"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    }
  },
  "required": [
    "id",
    "action_run_id",
    "alert_id",
    "team",
    "summary",
    "approval_code",
    "requested_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
