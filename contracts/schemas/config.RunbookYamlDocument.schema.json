{
  "$defs": {
    "ApprovalPolicy": {
      "enum": [
        "none",
        "required"
      ],
      "title": "ApprovalPolicy",
      "type": "string"
    },
    "RunIf": {
      "enum": [
        "always",
        "previous_failed",
        "previous_succeeded"
      ],
      "title": "RunIf",
      "type": "string"
    },
    "RunbookStep": {
      "additionalProperties": false,
      "description": "One normalized step. `text` and `params` are templates filled from the alert.",
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StepKind"
        },
        "text": {
          "examples": [
            "Rejected {{payload.currency}} {{payload.notional}}"
          ],
          "title": "Text",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "examples": [
                "rates-large-rejections"
              ],
              "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Action id; required for check/action steps that execute.",
          "title": "Action"
        },
        "params": {
          "additionalProperties": {
            "examples": [
              "Rejected {{payload.currency}} {{payload.notional}}"
            ],
            "type": "string"
          },
          "title": "Params",
          "type": "object"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = inherit from the action config."
        },
        "is_automatic": {
          "default": false,
          "description": "Runs without a click when the alert opens.",
          "title": "Is Automatic",
          "type": "boolean"
        },
        "run_if": {
          "$ref": "#/$defs/RunIf",
          "default": "always"
        },
        "max_attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "kind",
        "text"
      ],
      "title": "RunbookStep",
      "type": "object"
    },
    "StepKind": {
      "enum": [
        "text",
        "check",
        "action"
      ],
      "title": "StepKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Content of a `yaml`-format runbook file (config/runbooks/<id>.yaml).",
  "properties": {
    "id": {
      "examples": [
        "rates-large-rejections"
      ],
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "team": {
      "anyOf": [
        {
          "examples": [
            "rates-large-rejections"
          ],
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Team"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/RunbookStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "steps"
  ],
  "title": "RunbookYamlDocument",
  "type": "object"
}
