# Copy to .env. Demo values only; never commit real secrets.
POSTGRES_USER=alerting
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=alerting
DATABASE_URL=postgresql://alerting:change-me-local-only@postgres:5432/alerting
REDIS_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
MOCK_GATEWAY_URL=http://mock-gateway:8090
MOCK_GATEWAY_RETRY_FAILURES=2
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=30
PROMETHEUS_URL=http://prometheus:9090
PUBLIC_BASE_URL=http://localhost:5173
CONFIG_DIR=/app/config
INGEST_WORKERS=2
LOG_LEVEL=INFO
